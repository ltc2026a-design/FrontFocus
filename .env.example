# URL base de la API de FocusFlow (backend). Override del valor por defecto http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# Producción (Railway): apunta a la API pública de Railway y reconstruye.
# En Vercel se pone como Environment Variable (Project → Settings → Environment
# Variables → VITE_API_URL) y se redeployea. Para la app móvil (Capacitor) se
# compila con este mismo valor antes de `npx cap sync`.
# VITE_API_URL=https://TU-SERVICIO.up.railway.app/api
